    {
      "type": "text",
      "id": "key_points",
      "x": 120,
      "y": 445,
      "width": 640,
      "height": 90,
      "text": "KEY POINTS:\n• Crown of head lifts (as if suspended from above)\n• Shoulders remain relaxed and dropped throughout\n• Elbows slightly bent, never locked\n• Weight stays 50/50 on both feet\n• Movement initiated by intention, not muscle\n• Total duration: 12-16 seconds per repetition",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "left",
      "originalText": "KEY POINTS:\n• Crown of head lifts (as if suspended from above)\n• Shoulders remain relaxed and dropped throughout\n• Elbows slightly bent, never locked\n• Weight stays 50/50 on both feet\n• Movement initiated by intention, not muscle\n• Total duration: 12-16 seconds per repetition",
      "autoResize": true
    },
    {
      "type": "rectangle",
      "id": "mistakes_bg",
      "x": 100,
      "y": 570,
      "width": 680,
      "height": 100,
      "roundness": { "type": 3 },
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "boundElements": [{ "id": "mistakes", "type": "text" }]
    },
    {
      "type": "text",
      "id": "mistakes",
      "x": 120,
      "y": 585,
      "width": 640,
      "height": 70,
      "text": "COMMON MISTAKES:\n❌ Shoulders rise with arms → Consciously drop shoulders before beginning\n❌ Arms move too fast → Take full 4-6 second inhalation\n❌ Locking elbows → Maintain soft, rounded arm structure",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "left",
      "originalText": "COMMON MISTAKES:\n❌ Shoulders rise with arms → Consciously drop shoulders before beginning\n❌ Arms move too fast → Take full 4-6 second inhalation\n❌ Locking elbows → Maintain soft, rounded arm structure",
      "autoResize": true
    }
